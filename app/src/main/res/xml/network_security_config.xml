<?xml version="1.0" encoding="utf-8"?>
<!-- Kodi's JSON-RPC server is plain HTTP, and the phone reaches it at the TV's LAN address,
     which can't be listed in advance. Everything else the app fetches (GitHub) is HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
