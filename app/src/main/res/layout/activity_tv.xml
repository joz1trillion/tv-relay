<?xml version="1.0" encoding="utf-8"?>
<!-- TV screen: buttons on the left, read-only status on the right. Only the buttons take focus. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#141416">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingLeft="64dp"
        android:paddingTop="32dp"
        android:paddingRight="64dp"
        android:paddingBottom="60dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="TV audio to your phone"
                android:textColor="#A0A0A8"
                android:textSize="20sp" />

            <Button
                android:id="@+id/toggle"
                style="@style/TvButton"
                android:minHeight="88dp"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Manual: start on the TV. Auto: the phone can start it any time ("display over other apps"). -->
            <TextView
                android:id="@+id/startMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                                                android:paddingLeft="12dp"
                android:paddingTop="6dp"
                android:paddingRight="12dp"
                android:paddingBottom="6dp"
                android:textColor="#8E8E96"
                android:textSize="16sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="48dp"
            android:layout_weight="3"
            android:background="#1E1E22"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:id="@+id/state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#C8C8D0"
                android:textSize="22sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#8E8E96"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- TV settings: device mode and start mode. -->
    <ImageView
        android:id="@+id/settings"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginRight="6dp"
        android:background="@drawable/tv_chip"
        android:contentDescription="Settings"
        android:focusable="true"
        android:padding="12dp"
        android:src="@drawable/ic_settings" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="8dp"
        android:orientation="horizontal">

        <!-- For the phone's Connect directly; same look as the version label opposite. -->
        <TextView
            android:id="@+id/ip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="12dp"
            android:paddingTop="6dp"
            android:paddingRight="12dp"
            android:paddingBottom="6dp"
            android:textColor="#8E8E96"
            android:textSize="16sp" />

        <!-- Whether Kodi's web server answers on this TV; the gear's Settings explains Kodi lip sync. -->
        <TextView
            android:id="@+id/kodi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
                                    android:paddingLeft="12dp"
            android:paddingTop="6dp"
            android:paddingRight="12dp"
            android:paddingBottom="6dp"
            android:textColor="#8E8E96"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Version, with a dot when an update is out. Focusable: OK opens the update dialog. -->
    <TextView
        android:id="@+id/version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="8dp"
        android:background="@drawable/tv_chip"
        android:paddingLeft="12dp"
        android:paddingTop="6dp"
        android:paddingRight="12dp"
        android:paddingBottom="6dp"
        android:textColor="@color/tv_chip_text"
        android:textSize="16sp" />
</FrameLayout>
