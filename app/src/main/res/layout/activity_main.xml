<?xml version="1.0" encoding="utf-8"?>
<!-- Phone screen: three tabs, and the version (tap for updates) in the corner. Setting rows are built in MainActivity so each gets its ℹ️ button. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Shown instead of everything else in picture-in-picture. -->
    <TextView
        android:id="@+id/pipView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1C1C1E"
        android:gravity="center"
        android:padding="8dp"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/tabListen" style="@style/Tab" android:text="Listen" />
            <TextView android:id="@+id/tabSettings" style="@style/Tab" android:text="Settings" />
            <TextView android:id="@+id/tabKodi" style="@style/Tab" android:text="Kodi sync" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/pageListen"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/receive"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:minHeight="56dp"
                            android:text="Listen" />

                        <Button
                            android:id="@+id/stop"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:layout_weight="1"
                            android:minHeight="56dp"
                            android:text="Stop" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="monospace"
                        android:textSize="13sp" />

                    <TextView
                        style="@style/SectionHeader"
                        android:text="Latency (last 60 s, ms)" />

                    <com.joz.tvrelay.LatencyGraph
                        android:id="@+id/graph"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:alpha="0.7"
                        android:text="Doesn't include the TV's own capture delay, and may not include Bluetooth headphone delay; Android doesn't report either."
                        android:textSize="12sp" />

                    <!-- "Connect directly" dropdown, built in MainActivity. -->
                    <LinearLayout
                        android:id="@+id/listenExtras"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/pageSettings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/settingsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp" />
            </ScrollView>

            <ScrollView
                android:id="@+id/pageKodi"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/kodiList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp" />
            </ScrollView>
        </FrameLayout>

        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:background="?android:attr/selectableItemBackground"
            android:paddingLeft="12dp"
            android:paddingTop="6dp"
            android:paddingRight="12dp"
            android:paddingBottom="6dp"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
